<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base kiosk theme: no action bar, black ground. -->
    <style name="Theme.ZoeDispatchKiosk" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>

    <!-- Fullscreen variant used by the Activity. System bars are also hidden at
         runtime via WindowInsetsController for immersive-sticky behaviour. -->
    <style name="Theme.ZoeDispatchKiosk.Fullscreen" parent="Theme.ZoeDispatchKiosk">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="27">shortEdges</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

</resources>
