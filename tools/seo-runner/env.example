# SEO SERP-pull runner config. Copy this to ".env" (same folder) and fill it in. .env is gitignored.
# setup.ps1 creates this copy for you.

# The Zoe app origin.
APP_URL=https://zoe-dispatch.fly.dev

# The SAME value as the app's SEO_INGEST_TOKEN Fly secret (shared with /api/seo/cron). If the app has not set
# one yet, leave blank — the ingest endpoint fails OPEN until the token is set on both sides.
SEO_INGEST_TOKEN=

# Zoe's own public domain — the runner + app look for this in the SERP to find Zoe's listing and rank.
SEO_ZOE_DOMAIN=zoeeventsdmv.com

# The local rival domains to track (comma-separated, bare hosts). The engine already treats ANY non-Zoe,
# non-directory domain on a read SERP as a competitor; this is the curated set surfaced first. Example:
# SEO_COMPETITOR_DOMAINS=aabletents.com, dmvpartyrentals.com, loeventsrentals.com
SEO_COMPETITOR_DOMAINS=

# How many PENDING keywords to read per run. Keep this SMALL — Google rate-limits/blocks automated reads, so a
# tiny drip (a few/run, every few hours via the scheduled task) stays under the radar.
SEO_BATCH=3

# SERP locale.
SEO_SERP_GL=us
SEO_SERP_HL=en

# Pause between queries in ms (looks human + lowers block risk).
SEO_QUERY_DELAY_MS=2500

# SERP provider. "google-html" (default) reads live Google results HTML (free, no account, but fragile — Google
# may serve a consent wall / CAPTCHA, which the runner reports honestly as blocked). To switch to a robust
# API-based source later, set SEO_SERP_PROVIDER=api and point SEO_SERP_ENDPOINT at a SERP API that returns JSON
# (organic/results[...]); {q} {gl} {hl} are substituted. No app change needed — the ingest shape is the same.
SEO_SERP_PROVIDER=google-html
# SEO_SERP_ENDPOINT=https://api.example-serp.com/search?q={q}&gl={gl}&hl={hl}&key=...
# SEO_SERP_API_KEY=

# Optional: override the browser User-Agent used for the Google read.
# SEO_USER_AGENT=
