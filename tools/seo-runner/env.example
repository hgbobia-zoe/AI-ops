# SEO keyword-pull runner config. Copy this to ".env" (same folder) and fill it in. .env is gitignored.
# setup.ps1 creates this copy for you.

# The Zoe app origin.
APP_URL=https://zoe-dispatch.fly.dev

# The SAME value as the app's SEO_INGEST_TOKEN Fly secret (shared with /api/seo/cron). If the app has not set
# one yet, leave blank — the ingest endpoint fails OPEN until the token is set on both sides.
SEO_INGEST_TOKEN=

# How many PENDING keywords to pull per run. Free tier allows only a few lookups/day — keep this small and let
# the scheduled task drip. Raise it (and the task cadence) once on a paid plan.
SEO_BATCH=3

# The Ubersuggest MCP endpoint (override only for staging/testing).
# UBERSUGGEST_MCP_URL=https://ubersuggest-mcp.neilpatelapi.com/mcp

# The live tool name + arg mapping are UNVERIFIED until your first signed-in run (which dumps the real
# tools/list to boot.log and posts it to the app). Adjust these to the real tool once you see it.
SEO_KEYWORD_TOOL=keyword_overview
SEO_KEYWORD_ARG=keyword
SEO_TOOL_ARGS={"country":"US","language":"en"}

# OAuth loopback port for the one-time sign-in (must be free on this machine).
SEO_OAUTH_PORT=7331

# Where the OAuth tokens are cached (co-located with the runner by default). Leave unset for the default.
# SEO_CACHE_DIR=
