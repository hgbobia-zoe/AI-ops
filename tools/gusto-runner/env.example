# Gusto remote-browser runner config. Copy this to ".env" (same folder) and fill it in. .env is gitignored,
# so your token never gets committed. setup.ps1 creates this copy for you.

# The Zoe app origin.
APP_URL=https://zoe-dispatch.fly.dev

# The SAME long random value you set on Fly:  fly secrets set GUSTO_RUNNER_TOKEN=... -a zoe-dispatch
GUSTO_RUNNER_TOKEN=paste-the-same-value-you-set-on-fly

# Run with NO visible window (recommended for the background service). The payroll person still signs in from
# the /payroll pane - headless does not block interactive sign-in. Leave it unset only if you prefer a window.
GUSTO_HEADLESS=1

# NOTE: the runner keeps NO persistent Gusto profile. Each push uses a fresh, logged-out session and the person
# signs into Gusto with THEIR OWN credentials in the /payroll pane (so the write is audited to them in Gusto);
# the session is discarded when the push finishes. There is no GUSTO_PROFILE_DIR to configure.

# Where Playwright keeps its browser binaries. setup.ps1 sets this to a .pw-browsers folder NEXT TO the runner
# and installs the browsers there, so the runner is self-contained and the scheduled task always resolves them
# (the per-user AppData default can be invisible to a task under a redirected/sandboxed profile). GUSTO_HEADLESS=1
# needs the "chrome-headless-shell" browser, which is a SEPARATE download from chromium — setup.ps1 installs both.
# PLAYWRIGHT_BROWSERS_PATH=C:\Git\zoe-gusto-runner\.pw-browsers
