{
  "manifest_version": 3,
  "key": "",
  "name": "Zoe Auto-Pull + Opportunity Radar",
  "version": "1.6.8",
  "description": "Syncs a rental company's own Goodshuffle routes/bookings and Instawork shifts into its Zoe Ops dashboard. Office machine only.",
  "icons": { "16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png" },
  "permissions": ["scripting", "tabs", "storage", "activeTab", "alarms"],
  "host_permissions": [
    "https://pro.goodshuffle.com/*",
    "https://app.instawork.com/*",
    "https://app.gusto.com/*",
    "https://graphql.app.gusto.com/*",
    "https://ignition.zonarsystems.com/*",
    "https://wrfalckup5gc3flo7bizcsfmiq.appsync-api.us-east-1.amazonaws.com/*",
    "https://zoe-dispatch.fly.dev/*"
  ],
  "externally_connectable": { "matches": ["https://zoe-dispatch.fly.dev/*"] },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://pro.goodshuffle.com/*"],
      "js": ["pull-injected.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://pro.goodshuffle.com/app/project/detail*"],
      "js": ["create.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.instawork.com/*"],
      "js": ["instawork.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.gusto.com/*"],
      "js": ["gusto.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://app.gusto.com/*"],
      "js": ["gusto-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://ignition.zonarsystems.com/*"],
      "js": ["ignition.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["ignition-injected.js"],
      "matches": ["https://ignition.zonarsystems.com/*"]
    }
  ],
  "options_page": "options.html",
  "action": { "default_title": "Zoe Auto-Pull + Radar", "default_popup": "popup.html", "default_icon": { "16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png" } }
}
