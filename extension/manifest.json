{
  "manifest_version": 3,
  "key": "",
  "name": "Zoe Auto-Pull + Opportunity Radar",
  "version": "1.3.1",
  "description": "Keeps Zoe Ops fresh: the service worker schedules the pull with chrome.alarms and keeps a signed-in Goodshuffle tab alive (no tab to babysit), a declared content script does the read-pull, create_project ops are drained by background-opened tabs, and logging into Zoe Ops kicks an immediate sync. Also captures procurement/event opportunities into Opportunity Radar. Office machine only.",
  "permissions": ["scripting", "tabs", "storage", "activeTab", "alarms"],
  "host_permissions": ["https://pro.goodshuffle.com/*", "https://zoe-dispatch.fly.dev/*"],
  "externally_connectable": { "matches": ["https://zoe-dispatch.fly.dev/*"] },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://pro.goodshuffle.com/*"],
      "js": ["pull-injected.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://pro.goodshuffle.com/app/project/detail*"],
      "js": ["create.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": { "default_title": "Zoe Auto-Pull + Radar", "default_popup": "popup.html" }
}
